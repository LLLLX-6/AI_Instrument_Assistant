{
  "name": "@aia/deepseek-harness-hardware",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare:harness": "node scripts/prepare-frozen-harness.mjs",
    "generate:contracts": "node scripts/run-generator.mjs",
    "check:contracts": "node scripts/run-generator.mjs --check",
    "typecheck": "npm run prepare:harness && npm run check:contracts && tsc --noEmit --project tsconfig.json",
    "test:unit": "npm run prepare:harness && npm run check:contracts && node --test tests/contract/*.test.ts tests/unit/*.test.ts tests/architecture/*.test.ts",
    "test:e2e": "npm run prepare:harness && npm run check:contracts && node --test tests/e2e/*.test.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "build": "npm run typecheck && node scripts/build.mjs",
    "smoke:fake": "npm run prepare:harness && node scripts/smoke-fake-runtime.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.24.2",
    "typescript": "^5.9.2"
  },
  "aiaHarnessCompatibility": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness",
    "gitCommit": "d347e703908d0406b7a7ef80e3a0e594d86b2215",
    "dshToolsVersion": "0.1.3-alpha.1",
    "policy": "exact-reviewed-shape-only"
  }
}
