{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aia.local/protocols/evidence/v1/engineering-evidence-context.schema.json",
  "title": "AIA Evidence v1 Engineering Evidence Context Exchange View",
  "description": "Immutable composed view; never an independent evidence authority.",
  "type": "object",
  "required": [
    "contextId", "workflowId", "userGoal", "assembledAt", "designEvidence",
    "targets", "measurementContextId", "measurementContext", "crossReferences",
    "comparisons", "limitations", "unresolvedQuestions", "inferences", "assembler"
  ],
  "properties": {
    "contextId": {"type": "string", "format": "uuid"},
    "workflowId": {"type": "string", "minLength": 1, "maxLength": 256},
    "userGoal": {"type": "string", "minLength": 1, "maxLength": 2048},
    "assembledAt": {"type": "string", "format": "date-time"},
    "designEvidence": {"type": "array", "items": {"$ref": "#/$defs/designEvidenceItem"}, "maxItems": 256},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}, "maxItems": 128},
    "measurementContextId": {"type": ["string", "null"], "format": "uuid"},
    "measurementContext": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "https://aia.local/protocols/evidence/v1/teaching-evidence-context.schema.json"}
      ]
    },
    "crossReferences": {"type": "array", "items": {"$ref": "#/$defs/crossReference"}, "maxItems": 128},
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}, "maxItems": 256},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}, "uniqueItems": true},
    "unresolvedQuestions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "inferences": {"type": "array", "maxItems": 0}
    ,"assembler": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"measurementContext": {"type": "null"}}},
      "then": {"properties": {"measurementContextId": {"type": "null"}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "boundedValue": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "maxLength": 4096},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "object", "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      ]
    },
    "designEvidenceItem": {
      "type": "object",
      "required": ["evidenceId", "category", "kind", "label", "value", "unit", "documentCanonicalId", "snapshotId", "objectCanonicalId", "verificationState", "observedAt", "nativeRevision", "fingerprint"],
      "properties": {
        "evidenceId": {"type": "string", "format": "uuid"},
        "category": {"enum": ["DESIGN_FACT", "DESIGN_TARGET"]},
        "kind": {"enum": ["DOCUMENT_FACT", "CONNECTIVITY_FACT", "TARGET_DECLARATION"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "value": {"$ref": "#/$defs/boundedValue"},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "documentCanonicalId": {"type": "string", "minLength": 1},
        "snapshotId": {"type": "string", "format": "uuid"},
        "objectCanonicalId": {"type": ["string", "null"], "minLength": 1},
        "verificationState": {"enum": ["SNAPSHOT_BOUNDED", "USER_ASSERTED", "UNVERIFIED"]},
        "observedAt": {"type": "string", "format": "date-time"},
        "nativeRevision": {"type": ["string", "null"], "minLength": 1},
        "fingerprint": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["value", "scopeKind", "scopeVersion", "includedPaths"], "properties": {"value":{"type":"string","minLength":1},"scopeKind":{"type":"string","minLength":1},"scopeVersion":{"type":"string","minLength":1},"includedPaths":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true}}, "additionalProperties": false}
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["targetId", "category", "metric", "expectation", "tolerance", "provenance", "sourceEvidenceIds"],
      "properties": {
        "targetId": {"type": "string", "format": "uuid"},
        "category": {"const": "DESIGN_TARGET"},
        "metric": {"enum": ["FREQUENCY", "DUTY_CYCLE", "VOLTAGE", "PERIOD", "STATE", "OTHER"]},
        "expectation": {"$ref": "#/$defs/expectation"},
        "tolerance": {"oneOf": [{"type":"null"},{"$ref":"#/$defs/absoluteTolerance"},{"$ref":"#/$defs/relativeTolerance"}]},
        "provenance": {"enum": ["DESIGN_DERIVED", "USER_PROVIDED"]},
        "sourceEvidenceIds": {"type":"array","items":{"type":"string","format":"uuid"},"minItems":1,"uniqueItems":true}
      },
      "additionalProperties": false
    },
    "expectation": {
      "oneOf": [
        {"type":"object","required":["form","value","unit"],"properties":{"form":{"const":"EXACT_NUMERIC"},"value":{"type":"number"},"unit":{"type":"string","minLength":1}},"additionalProperties":false},
        {"type":"object","required":["form","minimum","maximum","unit"],"properties":{"form":{"const":"NUMERIC_RANGE"},"minimum":{"type":"number"},"maximum":{"type":"number"},"unit":{"type":"string","minLength":1}},"additionalProperties":false},
        {"type":"object","required":["form","value"],"properties":{"form":{"const":"DISCRETE"},"value":{"type":["string","boolean"]}},"additionalProperties":false}
      ]
    },
    "absoluteTolerance": {"type":"object","required":["form","value","unit"],"properties":{"form":{"const":"ABSOLUTE"},"value":{"type":"number","minimum":0},"unit":{"type":"string","minLength":1}},"additionalProperties":false},
    "relativeTolerance": {"type":"object","required":["form","ratio"],"properties":{"form":{"const":"RELATIVE"},"ratio":{"type":"number","minimum":0}},"additionalProperties":false},
    "crossReference": {
      "type":"object","required":["crossReferenceId","state","reasons","workflowId","probeTargetId","designSnapshotId","confirmationId","confirmationSource","confirmedBy","confirmedTargetRef","requestCorrelationId","measurementContextId","measurementChannel","confirmedAt","measuredAt"],
      "properties":{"crossReferenceId":{"type":"string","format":"uuid"},"state":{"enum":["VERIFIED_LINK","UNVERIFIED_LINK","MISMATCH","INSUFFICIENT_EVIDENCE"]},"reasons":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"workflowId":{"type":"string","minLength":1},"probeTargetId":{"type":["string","null"],"format":"uuid"},"designSnapshotId":{"type":["string","null"],"format":"uuid"},"confirmationId":{"type":["string","null"],"minLength":1},"confirmationSource":{"enum":["TRUSTED_USER_EVENT",null]},"confirmedBy":{"type":["string","null"],"minLength":1},"confirmedTargetRef":{"type":["string","null"],"minLength":1},"requestCorrelationId":{"type":["string","null"],"minLength":1},"measurementContextId":{"type":["string","null"],"format":"uuid"},"measurementChannel":{"enum":[1,2,null]},"confirmedAt":{"type":["string","null"],"format":"date-time"},"measuredAt":{"type":["string","null"],"format":"date-time"}},
      "additionalProperties":false
    },
    "comparison": {
      "type":"object","required":["metric","targetId","observedLabel","status","reason","difference","relativeDifference"],
      "properties":{"metric":{"type":"string","minLength":1},"targetId":{"type":"string","format":"uuid"},"observedLabel":{"type":["string","null"]},"status":{"enum":["MATCH","MISMATCH","INDETERMINATE"]},"reason":{"type":"string","minLength":1},"difference":{"oneOf":[{"type":"null"},{"type":"object","required":["value","unit"],"properties":{"value":{"type":"number"},"unit":{"type":"string","minLength":1}},"additionalProperties":false}]},"relativeDifference":{"type":["number","null"]}},
      "additionalProperties":false
    }
  }
}
