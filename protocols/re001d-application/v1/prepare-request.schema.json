{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-instrument-assistant.local/schemas/re001d-application/v1/prepare-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "operation", "workflow_id", "request_correlation_id", "user_text"],
  "properties": {
    "protocol": { "const": "aia-re001d-application/v1" },
    "operation": { "const": "prepare" },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "request_correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "user_text": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
