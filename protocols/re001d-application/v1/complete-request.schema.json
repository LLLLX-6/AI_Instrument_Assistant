{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-instrument-assistant.local/schemas/re001d-application/v1/complete-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "operation", "workflow_id", "request_correlation_id", "governed_receipt"],
  "properties": {
    "protocol": { "const": "aia-re001d-application/v1" },
    "operation": { "const": "complete" },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "request_correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "governed_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "contract_version", "kind", "status", "operations", "failure_code"],
      "properties": {
        "contract": { "const": "aia-re001c-lite-validation" },
        "contract_version": { "const": "1.0" },
        "kind": { "const": "governed_measurement_receipt" },
        "status": { "const": "COMPLETED" },
        "operations": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/receiptItem" } },
        "failure_code": { "type": "null" }
      }
    }
  },
  "$defs": {
    "receiptItem": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "channel", "scope_remaining_invocations", "policy_reason", "ipc_dispatch_count", "hardware_execution_count", "canonical_result", "failure_code"],
      "properties": {
        "operation": { "enum": ["hardware.measure_frequency", "hardware.measure_vpp"] },
        "channel": { "enum": [1, 2] },
        "scope_remaining_invocations": { "const": 0 },
        "policy_reason": { "const": "allowed_confirmed_physical_setup" },
        "ipc_dispatch_count": { "const": 1 },
        "hardware_execution_count": { "const": 1 },
        "canonical_result": { "type": "object", "minProperties": 4, "maxProperties": 4 },
        "failure_code": { "type": "null" }
      }
    }
  }
}
