{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aia://protocol/jlceda/v1/messages/eda-selection",
  "title": "AIA-JLCEDA Protocol v1 Selection Operation",
  "description": "Authenticated read-only selection observation. Schema validates individual messages; correlation, active-session ownership, coherent document observation, timeouts, and duplicate responses remain Protocol State Machine rules.",
  "$defs": {
    "getSelectionRequest": {
      "type": "object",
      "allOf": [
        { "$ref": "aia://protocol/jlceda/v1/common/envelope#/$defs/baseEnvelopeFields" },
        {
          "required": ["session_id", "kind", "operation", "payload"],
          "properties": {
            "session_id": { "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/sessionId" },
            "kind": { "const": "request" },
            "operation": { "const": "eda.selection.get" },
            "payload": {
              "type": "object",
              "maxProperties": 0,
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "getSelectionSuccessResponse": {
      "type": "object",
      "allOf": [
        { "$ref": "aia://protocol/jlceda/v1/common/envelope#/$defs/baseEnvelopeFields" },
        {
          "required": [
            "session_id", "kind", "operation", "reply_to_message_id",
            "status", "payload"
          ],
          "properties": {
            "session_id": { "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/sessionId" },
            "kind": { "const": "response" },
            "operation": { "const": "eda.selection.get" },
            "reply_to_message_id": { "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/messageId" },
            "status": { "const": "success" },
            "payload": {
              "type": "object",
              "required": ["context"],
              "properties": {
                "context": { "$ref": "aia://protocol/jlceda/v1/models/selection-context" }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "getSelectionErrorResponse": {
      "type": "object",
      "allOf": [
        { "$ref": "aia://protocol/jlceda/v1/common/envelope#/$defs/baseEnvelopeFields" },
        {
          "required": [
            "session_id", "kind", "operation", "reply_to_message_id",
            "status", "error"
          ],
          "properties": {
            "session_id": { "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/sessionId" },
            "kind": { "const": "response" },
            "operation": { "const": "eda.selection.get" },
            "reply_to_message_id": { "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/messageId" },
            "status": { "const": "error" },
            "error": { "$ref": "aia://protocol/jlceda/v1/common/errors#/$defs/edaOperationError" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
