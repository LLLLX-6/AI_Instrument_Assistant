{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aia://protocol/jlceda/v1/common/errors",
  "title": "AIA-JLCEDA Protocol v1 Structured Errors",
  "$defs": {
    "edaOperationError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "capability_unsupported",
            "inconsistent_observation",
            "no_active_document",
            "operation_not_allowed",
            "provider_error",
            "internal_error",
            "strong_guard_unavailable",
            "stale_design_snapshot",
            "object_not_found",
            "unsupported_target",
            "ambiguous_target",
            "scope_expansion_required",
            "presentation_unsupported",
            "idempotency_conflict",
            "idempotency_capacity_exceeded",
            "session_invalid"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  }
}
