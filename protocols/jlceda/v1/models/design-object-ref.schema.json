{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aia://protocol/jlceda/v1/models/design-object-ref",
  "title": "DesignObjectRef",
  "description": "A bounded reference to a design object within one AIA observation. provider_kind may retain a finite provider-native classification without exposing the provider object.",
  "type": "object",
  "required": [
    "model_version",
    "provider",
    "object_type",
    "document_id",
    "snapshot_id",
    "native_id",
    "canonical_id",
    "display_name"
  ],
  "properties": {
    "model_version": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/modelVersion"
    },
    "provider": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/provider"
    },
    "object_type": {
      "type": "string",
      "enum": [
        "document",
        "net",
        "wire",
        "component",
        "other"
      ]
    },
    "document_id": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/documentId"
    },
    "snapshot_id": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/snapshotId"
    },
    "native_id": {
      "description": "Provider-supplied object identifier when available; null means the provider exposed no stable native identifier.",
      "oneOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/nativeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_id": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/canonicalId"
    },
    "display_name": {
      "description": "Provider-supplied display name, or null when the provider does not expose one.",
      "oneOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/displayName"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_kind": {
      "description": "Optional finite provider-native object classification for diagnostics and compatibility.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
