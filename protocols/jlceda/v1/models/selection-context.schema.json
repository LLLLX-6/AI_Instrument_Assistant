{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aia://protocol/jlceda/v1/models/selection-context",
  "title": "SelectionContext",
  "description": "Selection state plus safely derived circuit-net context from the same provider/document/snapshot observation. A derived net need not itself be a selected primitive.",
  "type": "object",
  "required": [
    "model_version",
    "selection",
    "nets"
  ],
  "properties": {
    "model_version": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/modelVersion"
    },
    "selection": {
      "$ref": "aia://protocol/jlceda/v1/models/design-selection"
    },
    "nets": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "aia://protocol/jlceda/v1/models/circuit-net"
      }
    }
  },
  "additionalProperties": false
}
