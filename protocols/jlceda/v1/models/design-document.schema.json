{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aia://protocol/jlceda/v1/models/design-document",
  "title": "DesignDocument",
  "description": "A bounded AIA observation of an active JLCEDA design document. Integration runtime metadata is deliberately excluded.",
  "type": "object",
  "required": [
    "model_version",
    "document_ref",
    "project_id",
    "project_name",
    "document_name",
    "document_type",
    "native_revision",
    "fingerprint",
    "is_dirty",
    "captured_at"
  ],
  "properties": {
    "model_version": {
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/modelVersion"
    },
    "document_ref": {
      "allOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/models/design-object-ref"
        },
        {
          "type": "object",
          "properties": {
            "object_type": {
              "const": "document"
            }
          }
        }
      ]
    },
    "project_id": {
      "oneOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/projectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_name": {
      "oneOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/displayName"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_name": {
      "oneOf": [
        {
          "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/displayName"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "schematic",
        "pcb",
        "symbol",
        "footprint",
        "home",
        "blank",
        "other"
      ]
    },
    "native_revision": {
      "description": "Official provider revision when supplied by the EDA API; null when unavailable. It must never be synthesized from the fingerprint.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint": {
      "description": "Complete finite content projection fingerprint, or null when the provider observation cannot support a meaningful fingerprint.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value",
            "scope_kind",
            "scope_version",
            "included_paths"
          ],
          "properties": {
            "value": {
              "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/contentFingerprint"
            },
            "scope_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "scope_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "included_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "is_dirty": {
      "description": "Provider dirty state, or null when the provider does not expose it.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "captured_at": {
      "description": "AIA observation timestamp; it is not a provider revision.",
      "$ref": "aia://protocol/jlceda/v1/common/identifiers#/$defs/utcTimestamp"
    }
  },
  "additionalProperties": false
}
