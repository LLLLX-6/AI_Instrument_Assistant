    { "$ref": "aia://protocol/jlceda/v1/messages/heartbeat#/$defs/ping" },
    { "$ref": "aia://protocol/jlceda/v1/messages/heartbeat#/$defs/pong" },
    { "$ref": "aia://protocol/jlceda/v1/messages/eda-document#/$defs/getActiveRequest" },
