{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aia.local/protocols/harness-hardware/v1/common/identifiers.schema.json",
  "title": "AIA Harness Hardware v1 identifiers",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "hmacSha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "connectionGeneration": {
      "type": "integer",
      "minimum": 1
    }
  }
}
