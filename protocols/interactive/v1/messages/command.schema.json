{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aia.local/protocols/interactive/v1/messages/command.schema.json",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "message_id", "sent_at", "message_type", "application_generation", "session_id", "correlation_id", "command", "payload"],
      "properties": {
        "protocol": {"const": "aia-interactive/v1"},
        "message_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "sent_at": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/timestamp"},
        "message_type": {"const": "command"},
        "application_generation": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "session_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "correlation_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/boundedText"},
        "command": {"enum": ["workflow.start", "design.observe", "measurement.prepare", "view.highlight", "workflow.cancel", "teaching.publish"]},
        "payload": {}
      }
    },
    "workflowRef": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "expected_workflow_revision"],
      "properties": {
        "workflow_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "expected_workflow_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "start": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "command": {"const": "workflow.start"},
        "payload": {"type": "object", "additionalProperties": false, "required": ["safe_label", "harness_conversation_id"], "properties": {
          "safe_label": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/shortText"},
          "harness_conversation_id": {"oneOf": [{"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/opaqueIdentity"}, {"type": "null"}]}
        }}
      }}]
    },
    "observe": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {"command": {"const": "design.observe"}, "payload": {"$ref": "#/$defs/workflowRef"}}}]
    },
    "prepare": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "command": {"const": "measurement.prepare"},
        "payload": {"type": "object", "additionalProperties": false, "required": ["workflow_id", "expected_workflow_revision", "probe_target_identity", "operations", "channel"], "properties": {
          "workflow_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
          "expected_workflow_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "probe_target_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/opaqueIdentity"},
          "operations": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/semanticOperation"}},
          "channel": {"type": ["integer", "null"], "enum": [null, 1, 2]}
        }}
      }}]
    },
    "highlight": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {"command": {"const": "view.highlight"}, "payload": {"$ref": "#/$defs/workflowRef"}}}]
    },
    "cancel": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "command": {"const": "workflow.cancel"},
        "payload": {"type": "object", "additionalProperties": false, "required": ["workflow_id", "expected_workflow_revision", "reason"], "properties": {
          "workflow_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
          "expected_workflow_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "reason": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/shortText"}
        }}
      }}]
    },
    "publish": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {"command": {"const": "teaching.publish"}, "payload": {"$ref": "#/$defs/workflowRef"}}}]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/start"}, {"$ref": "#/$defs/observe"},
    {"$ref": "#/$defs/prepare"}, {"$ref": "#/$defs/highlight"},
    {"$ref": "#/$defs/cancel"}, {"$ref": "#/$defs/publish"}
  ]
}
