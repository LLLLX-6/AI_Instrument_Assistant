{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aia.local/protocols/interactive/v1/messages/hello.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_id", "sent_at", "message_type", "frontend_kind", "client_instance_id", "supported_versions", "resume_cursor"],
  "properties": {
    "protocol": {"const": "aia-interactive/v1"},
    "message_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
    "sent_at": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/timestamp"},
    "message_type": {"const": "hello"},
    "frontend_kind": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/frontendKind"},
    "client_instance_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
    "supported_versions": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "resume_cursor": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}
  }
}
