{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aia.local/protocols/interactive/v1/messages/challenge-answer.schema.json",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "message_id", "sent_at", "message_type", "application_generation", "session_id", "workflow_id", "expected_workflow_revision", "challenge_id", "challenge_kind", "nonce", "answer"],
      "properties": {
        "protocol": {"const": "aia-interactive/v1"},
        "message_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "sent_at": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/timestamp"},
        "message_type": {"const": "challenge_answer"},
        "application_generation": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "session_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "workflow_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "expected_workflow_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "challenge_id": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/uuid"},
        "challenge_kind": {"enum": ["DESIGN_SELECTION", "OPERATION_AUTHORIZATION", "PHYSICAL_SETUP"]},
        "nonce": {"type": "string", "minLength": 24, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
        "answer": {}
      }
    },
    "designAnswer": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "challenge_kind": {"const": "DESIGN_SELECTION"},
        "answer": {"type": "object", "additionalProperties": false, "required": ["candidate_set_identity", "candidate_identity"], "properties": {
          "candidate_set_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/contentIdentity"},
          "candidate_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/opaqueIdentity"}
        }}
      }}]
    },
    "operationAnswer": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "challenge_kind": {"const": "OPERATION_AUTHORIZATION"},
        "answer": {"type": "object", "additionalProperties": false, "required": ["operation_plan_identity", "authorized"], "properties": {
          "operation_plan_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/contentIdentity"},
          "authorized": {"type": "boolean"}
        }}
      }}]
    },
    "physicalAnswer": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/base"}, {"properties": {
        "challenge_kind": {"const": "PHYSICAL_SETUP"},
        "answer": {"type": "object", "additionalProperties": false, "required": ["probe_target_identity", "operation_plan_identity", "channel", "maximum_expected_voltage_v", "probe_connected", "common_ground_confirmed", "voltage_range_confirmed", "wiring_unchanged"], "properties": {
          "probe_target_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/opaqueIdentity"},
          "operation_plan_identity": {"$ref": "https://aia.local/protocols/interactive/v1/common/identifiers.schema.json#/$defs/contentIdentity"},
          "channel": {"type": "integer", "enum": [1, 2]},
          "maximum_expected_voltage_v": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
          "probe_connected": {"type": "boolean"},
          "common_ground_confirmed": {"type": "boolean"},
          "voltage_range_confirmed": {"type": "boolean"},
          "wiring_unchanged": {"type": "boolean"}
        }}
      }}]
    }
  },
  "oneOf": [{"$ref": "#/$defs/designAnswer"}, {"$ref": "#/$defs/operationAnswer"}, {"$ref": "#/$defs/physicalAnswer"}]
}
